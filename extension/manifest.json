{
  "manifest_version": 3,
  "name": "DT Browser Bridge",
  "version": "0.2.0",
  "description": "Connect dt CLI to existing Chrome tabs through a local native messaging host.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": ["debugger", "tabs", "nativeMessaging", "storage"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "DT Browser Bridge" }
}
