{
  "name": "browser-agent-cli",
  "version": "0.1.0",
  "description": "On-demand CLI control for a local Chrome browser",
  "type": "module",
  "bin": {
    "dt": "./bin/dt.js"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "scripts",
    "extension",
    "companion/menubar",
    "companion/package.json",
    "companion/README.md"
  ],
  "scripts": {
    "demo": "node scripts/demo.mjs",
